DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public"

PORT=3000

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

GEMINI_API_KEY="replace-with-your-gemini-api-key"

FRONTEND_URL="http://localhost:3001"

RESEND_API_KEY="replace-with-your-resend-api-key"
# Optional: defaults to Resend's shared onboarding@resend.dev sender, which
# needs no domain verification. Override once a custom domain is verified.
RESEND_FROM_EMAIL="Traverse <onboarding@resend.dev>"

GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
